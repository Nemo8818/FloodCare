import { DatabaseSync } from 'node:sqlite';
import { readFileSync, readdirSync } from 'node:fs';
import assert from 'node:assert/strict';
import { handle } from '../lib/api-core.ts';
const sqlite = new DatabaseSync(':memory:');
for(const file of readdirSync('drizzle').filter(f=>f.endsWith('.sql')))sqlite.exec(readFileSync('drizzle/'+file,'utf8'));
const DB={prepare(sql:string){let bindings:any[]=[];const prepared={bind(...values:any[]){bindings=values;return prepared;},async first(){return sqlite.prepare(sql).get(...bindings)||null;},async all(){return {results:sqlite.prepare(sql).all(...bindings)};},async run(){const r=sqlite.prepare(sql).run(...bindings);return {meta:{changes:Number(r.changes)}};}};return prepared;}};
const photos=new Map();
const BUCKET={async put(key:string,bytes:any,meta:any){photos.set(key,{bytes,meta});},async get(key:string){const p=photos.get(key);return p?{body:p.bytes,httpMetadata:p.meta.httpMetadata}:null;},async delete(key:string){photos.delete(key);}};
const env={DB,BUCKET,STAFF_PASSWORD:'FCSFight'};
const owner='aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa',other='bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb';
async function call(path:string,body?:any,headers:any={}){const req=new Request('https://example.test'+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json',Origin:'https://example.test',...headers},body:body?JSON.stringify(body):undefined});const r=await handle(req,env);const data=await r.json();return {status:r.status,data};}
assert.equal((await call('/api/requests')).status,401);
assert.equal((await call('/api/login',{password:'wrong'})).status,401);
const login=await call('/api/login',{password:'FCSFight'});assert.equal(login.status,200);const auth={'X-Staff-Session':login.data.session};
const entry={id:'SOS-test',type:'SOS',name:'Demo',phone:'000000',address:'Fictional',reason:'Flood',people:'2',attachments:[{data:'data:image/jpeg;base64,/9j/AA=='}]};
const created=await call('/api/requests',entry,{'X-Owner':owner});assert.equal(created.status,201);assert.equal(photos.size,1);assert.equal(created.data.record.attachments[0].url,'/api/photo/SOS-test/0');
assert.equal((await call('/api/requests',undefined,{'X-Owner':other})).data.records.length,0);
assert.equal((await call('/api/requests',undefined,auth)).data.records.length,1);
let image=await handle(new Request('https://example.test/api/photo/SOS-test/0',{headers:auth}),env);assert.equal(image.status,200);assert.equal((await image.arrayBuffer()).byteLength,4);
image=await handle(new Request('https://example.test/api/photo/SOS-test/0'),env);assert.equal(image.status,401);
assert.equal((await call('/api/status',{id:'SOS-test',status:'รับเรื่องแล้ว'},{'X-Owner':owner})).status,401);
assert.equal((await call('/api/status',{id:'SOS-test',status:'รับเรื่องแล้ว'},auth)).status,200);
assert.equal((await call('/api/requests',entry,{'X-Owner':owner})).data.record.status,'รับเรื่องแล้ว');assert.equal(photos.size,1);
assert.equal((await call('/api/requests',entry,{'X-Owner':other})).status,409);
const bad={...entry,id:'SOS-bad',attachments:[{data:'data:image/svg+xml;base64,PHN2Zz4='}]};assert.equal((await call('/api/requests',bad,{'X-Owner':owner})).status,400);
assert.equal((await call('/api/status',{id:'SOS-test',status:'ปิดงาน'},auth)).status,200);
assert.equal((await call('/api/requests',undefined,auth)).data.records[0].status,'ปิดงาน');
assert.equal((await call('/api/status',{id:'SOS-test',status:'รับเรื่องแล้ว'},auth)).status,200);
assert.equal((await call('/api/requests',undefined,auth)).data.records[0].history.length,3);
await call('/api/logout',{},auth);assert.equal((await call('/api/requests',undefined,auth)).status,401);
console.log('PASS: hosted login, ownership isolation, staff roles, image upload/read authorization, status roundtrip, retry deduplication, validation, logout');
